# SolarGuard AI Configuration

# Server Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False
SECRET_KEY=solarguard_ai_secure_secret_key_2026

# Camera Settings
# CAMERA_SOURCE can be USB device index (0, 1), -1 for Virtual Simulation,
# or Mobile Phone IP Webcam URL: e.g. http://192.168.1.100:8080/video
CAMERA_INDEX=0
CAMERA_SOURCE=0
IP_WEBCAM_URL=http://192.168.1.100:8080/video
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# ESP32 Wi-Fi Node Configuration
ESP32_IP=192.168.1.150
ESP32_PORT=80
ESP32_TIMEOUT=2.5
ESP32_MAX_RETRIES=3

# Dust Detection Thresholds (0 - 100%)
# Soiling index below CLEAN_THRESHOLD is classified as CLEAN
THRESHOLD_CLEAN=22.0
# Soiling index between CLEAN and HEAVY is MODERATELY DUSTY
THRESHOLD_HEAVY=48.0

# Detection Smoothing and Debouncing
# Consecutive readings required before switching states to prevent oscillation
CONSECUTIVE_DETECTIONS_REQUIRED=3
SCAN_INTERVAL_SECONDS=2.0

# Region of Interest (ROI) [0.0 - 1.0 relative coordinates: x_min, y_min, x_max, y_max]
ROI_X_MIN=0.05
ROI_Y_MIN=0.05
ROI_X_MAX=0.95
ROI_Y_MAX=0.95

# Storage
DATABASE_PATH=data/solarguard.db
REFERENCE_IMAGE_PATH=reference_images/clean_reference.jpg
LOG_PATH=logs/application.log
